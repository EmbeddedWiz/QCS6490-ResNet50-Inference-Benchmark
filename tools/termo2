#!/bin/bash

color_temp() {
    awk -v t="$1" 'BEGIN {
        if (t >= 75) printf "\033[31m%5.1f°C\033[0m", t;
        else if (t >= 60) printf "\033[33m%5.1f°C\033[0m", t;
        else printf "\033[32m%5.1f°C\033[0m", t;
    }'
}

read_cpu_stats() {
    awk '
        /^cpu[0-9]+ / {
            busy  = $2 + $3 + $4 + $7 + $8 + $9;
            total = busy + $5 + $6;
            print $1, busy, total;
        }
    ' /proc/stat
}

declare -A prev_busy
declare -A prev_total

while read -r cpu busy total; do
    prev_busy["$cpu"]=$busy
    prev_total["$cpu"]=$total
done < <(read_cpu_stats)

while true; do

    sleep 0.5

    max_load=0

    while read -r cpu busy total; do

        old_busy=${prev_busy["$cpu"]}
        old_total=${prev_total["$cpu"]}

        if [[ -n "$old_busy" && -n "$old_total" ]]; then
            delta_busy=$((busy - old_busy))
            delta_total=$((total - old_total))

            if (( delta_total > 0 )); then
                load=$(awk -v b="$delta_busy" -v t="$delta_total" \
                    'BEGIN { printf "%.0f", 100 * b / t }')

                if (( load > max_load )); then
                    max_load=$load
                fi
            fi
        fi

        prev_busy["$cpu"]=$busy
        prev_total["$cpu"]=$total

    done < <(read_cpu_stats)

    cpu=$(for z in /sys/class/thermal/thermal_zone*; do
        t=$(cat "$z/type")
        case "$t" in
            cpu[0-9]*-thermal) cat "$z/temp";;
        esac
    done | sort -n | tail -1)

    gpu=$(for z in /sys/class/thermal/thermal_zone*; do
        t=$(cat "$z/type")
        case "$t" in
            gpuss*-thermal) cat "$z/temp";;
        esac
    done | sort -n | tail -1)

    npu=$(for z in /sys/class/thermal/thermal_zone*; do
        t=$(cat "$z/type")
        case "$t" in
            nspss*-thermal) cat "$z/temp";;
        esac
    done | sort -n | tail -1)

    soc=$(for z in /sys/class/thermal/thermal_zone*; do
        t=$(cat "$z/type")
        case "$t" in
            cpu[0-9]*-thermal|gpuss*-thermal|nspss*-thermal|video-thermal|ddr-thermal|camera*-thermal)
                cat "$z/temp";;
        esac
    done | sort -n | tail -1)

    skin=$(for z in /sys/class/thermal/thermal_zone*; do
        [ "$(cat "$z/type")" = "msm-skin-thermal" ] && cat "$z/temp"
    done)

    clear

    printf "CPU MAX:  "
    color_temp "$(awk "BEGIN{print $cpu/1000}")"
    printf "   %3d%%\n" "$max_load"

    printf "SoC MAX:  "
    color_temp "$(awk "BEGIN{print $soc/1000}")"
    echo

    printf "SKIN:     "
    color_temp "$(awk "BEGIN{print $skin/1000}")"
    echo

    printf "GPU MAX:  "
    color_temp "$(awk "BEGIN{print $gpu/1000}")"
    echo

    printf "NPU MAX:  "
    color_temp "$(awk "BEGIN{print $npu/1000}")"
    echo

done

